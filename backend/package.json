{
  "name": "veyron-smtp-gateway-backend",
  "version": "1.0.0",
  "description": "Production-oriented, lightweight, scalable SMTP Gateway for multi-tenant email delivery",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/workers/emailWorker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/workers/emailWorker.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "smtp",
    "gateway",
    "nodemailer",
    "bullmq",
    "redis",
    "email-relay"
  ],
  "author": "Veyron Engineering",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
