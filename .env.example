# ========================================================
# Veyron SMTP Gateway - Environment Configuration
# ========================================================

# Node Environment ('production', 'development', 'test')
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security & Encryption Keys
# JWT Secret for Admin Dashboard Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_very_long_secure_random_jwt_secret_64_chars_min
JWT_EXPIRES_IN=24h

# Master Encryption Key for AES-256-GCM SMTP Credential Storage at Rest
# Must be exactly 32 bytes (64 hex characters). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MongoDB Atlas External Database
# Standard format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veyron_smtp_gateway?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dbUser:SecurePassword123@cluster0.abcde.mongodb.net/veyron_smtp_gateway?retryWrites=true&w=majority&appName=VeyronGateway
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Redis Connection (Internal Docker Network or External Redis)
REDIS_HOST=mail-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password_or_leave_blank
REDIS_DB=0

# BullMQ Worker Configuration
WORKER_CONCURRENCY=5
JOB_MAX_RETRIES=3
JOB_TIMEOUT_MS=30000

# Rate Limiting & Safety
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
MAX_EMAIL_BODY_SIZE=10mb
MAX_ATTACHMENT_SIZE_MB=15

# CORS Allowlist for Frontend Dashboard (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://your-admin-dashboard.vercel.app

# Initial Admin Bootstrap (Created on first run if no admin exists)
ADMIN_INITIAL_EMAIL=admin@veyron.internal
ADMIN_INITIAL_PASSWORD=ChangeThisMasterAdminPassword123!

# Structured Logging
LOG_LEVEL=info

# Testing / Local Development Mock Mode
# Set to 'true' to use in-memory / nodemailer mock transport without requiring active SMTP accounts
MOCK_SMTP_ENABLED=false
